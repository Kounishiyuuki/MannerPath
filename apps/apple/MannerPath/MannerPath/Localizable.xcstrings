    "Attribution for sources stored with the nearby tile cache. This information remains available without a network connection. A source can appear more than once when saved tiles contain different wording.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "近くの場所とともに保存された出典情報です。通信できないときも確認できます。保存された情報の表記が異なる場合、同じ情報源が複数回表示されることがあります。"
          }
        }
      }
    },
    "Attribution text unavailable in cached data": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存済みデータに出典の説明がありません"
          }
        }
      }
    },
    "Attribution: %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "出典: %@"
          }
        }
      }
    },
    "Based on reported hours when available. Follow on-site rules and signs.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "営業時間の情報がある場合は、その情報に基づきます。現地のルールや掲示に従ってください。"
          }
        }
      }
    },
    "Bearing": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "方角"
          }
        }
      }
    },
    "Before you continue": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ご利用の前に"
          }
        }
      }
    },
    "Cached nearby data remains available offline. Walking routes may require a network connection.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存済みの近くの場所はオフラインでも確認できます。徒歩ルートには通信が必要な場合があります。"
          }
        }
