      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "24時間以内に確認"
          }
        }
      }
    },
    "Location is approximate, within %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "位置は%@内の目安です"
          }
        }
