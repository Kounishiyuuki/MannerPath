{
  "name": "@mannerpath/api",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=23.3"
  },
  "scripts": {
    "test": "node --experimental-strip-types --experimental-sqlite --no-warnings --test test/*.test.ts && npm run test:discovery",
    "test:discovery": "node --experimental-sqlite --no-warnings --test ../data-pipeline/discovery/*.test.mjs",
    "discover:sources": "node --experimental-sqlite --no-warnings ../data-pipeline/discovery/cli.mjs",
    "typecheck": "tsc -p .",
    "dev": "wrangler dev --local",
    "local:migrate": "wrangler d1 migrations apply DB --local",
    "local:reports:migrate": "wrangler d1 migrations apply REPORTS_DB --local",
    "local:pipeline": "node --experimental-strip-types --no-warnings scripts/local-pipeline.ts",
    "local:registry": "node --experimental-strip-types --no-warnings scripts/apply-source-registry.ts",
    "local:reports": "node --experimental-strip-types --no-warnings scripts/report-queue.ts",
    "local:reports:redact": "node --experimental-strip-types --no-warnings scripts/report-queue.ts retain",
    "reports:moderate": "node --experimental-strip-types --no-warnings scripts/report-queue.ts",
    "local:smoke": "node --experimental-strip-types --no-warnings scripts/smoke.ts",
    "local:export": "node --experimental-strip-types --no-warnings scripts/export-promotion.ts",
    "local:verify-promotion": "node --experimental-strip-types --no-warnings scripts/verify-promotion.ts",
    "local:quality": "node --experimental-strip-types --no-warnings scripts/data-quality.ts",
    "replay:derived-coordinates": "node --experimental-strip-types --no-warnings scripts/derived-coordinate-replay.ts",
    "replay:coverage": "node --experimental-strip-types --no-warnings scripts/coverage-replay.ts",
    "coverage:targets": "node --experimental-strip-types --no-warnings scripts/coverage-targets.ts",
    "e2e:config": "node --experimental-strip-types --no-warnings scripts/disposable-env.ts",
    "community:seed": "node --experimental-strip-types --experimental-sqlite --no-warnings scripts/community-seed.ts",
    "community:status": "node --experimental-strip-types --no-warnings scripts/community-activation.ts status",
    "community:activate": "node --experimental-strip-types --no-warnings scripts/community-activation.ts activate",
    "scale:community": "node --experimental-strip-types --experimental-sqlite --no-warnings scripts/scale-community.ts",
    "scale:tiles": "node --experimental-strip-types --experimental-sqlite --no-warnings scripts/scale-tiles.ts",
    "campaign:progress": "node --experimental-strip-types --no-warnings scripts/campaign-progress.ts"
  },
  "dependencies": {
    "hono": "4.13.8",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260919.1",
    "typescript": "7.0.2",
    "wrangler": "4.135.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
