// Worker configuration. The top level is the LOCAL development environment; `env.staging` and
// `env.production` are the staging / production-like shapes described in `../../docs/OPERATIONS.md`.
//
// No environment here can reach a real database: every `database_id` is a placeholder (all zeros for the canonical
// `DB`, all zeros but a final 1 for `REPORTS_DB`, so the two never share local state), and a `--remote` or `deploy`
// command fails until a maintainer creates the database and lands the real ID in a reviewed change
// (`services/AGENTS.md`). That is deliberate, and `test/deploy-config.test.ts` enforces it.
//
// Two D1 bindings (ADR-0014). `DB` is the canonical DATA_DB: tiles, spots, provenance, publication; it is replaced by
// every blue/green cutover, and a cutover changes ONLY this binding. `REPORTS_DB` is the durable report store:
// reports, moderation, App Attest keys and challenges, rate limits; it is created once per environment, migrated
// in place from `migrations-reports`, and never switched by a cutover or a rollback. Secrets (REPORT_SUBMITTER_PEPPER) are never `vars`; they are set with
// `wrangler secret put` per environment and are not committed.
//
// Remote reports require App Attest: staging and production set REPORT_ATTESTATION=required, which
// fails closed until a maintainer sets REPORT_APP_ATTEST_APP_ID (App ID prefix, usually the Team ID,
// plus bundle ID), REPORT_APP_ATTEST_ENVIRONMENT and REPORT_APP_ATTEST_BUNDLE_VERSIONS per
// environment. None is ever committed (docs/OPERATIONS.md).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mannerpath-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  // Automatic invocation logs are OFF in every environment: Cloudflare records the request URL in a
  // Fetch invocation log, and a MannerPath tile path is a z14 cell the user was looking at, so
  // persisting those would build exactly the location history this project must not keep. Sampling
  // would only make that history smaller, not absent. Explicit logs stay enabled so a future
  // diagnostic line (which must carry no request payload or position) is still visible; platform
  // metrics are aggregate and unaffected. Policy: `../../docs/OPERATIONS.md`.
  "observability": { "enabled": true, "logs": { "enabled": true, "invocation_logs": false } },
  // LOCAL/TEST ONLY. Unattested (schema 1) reports are accepted here because the local default is
  // `disabled`; the remote environments below require App Attest (ADR-0007 §6).
  "vars": { "REPORT_ATTESTATION": "disabled" },
  // Content-addressed raw source artifacts (src/refresh/artifact-store.ts). Each environment names its own
  // bucket; creating it is a maintainer's action (docs/OPERATIONS.md). A check never writes elsewhere.
  "r2_buckets": [{ "binding": "RAW_ARTIFACTS", "bucket_name": "mannerpath-raw-artifacts" }],
  // Source checks fetch, fingerprint and retain only; they never apply data. Still, no environment commits a
  // schedule: enabling one is a maintainer's action (docs/OPERATIONS.md), and test/deploy-config.test.ts holds it.
  "triggers": { "crons": [] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mannerpath",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    },
    {
      "binding": "REPORTS_DB",
      "database_name": "mannerpath-reports",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "migrations-reports"
    }
  ],
  // Named environments are not merged with the top level for these keys: each one repeats its own
  // vars, bindings and observability settings in full.
  "env": {
    "staging": {
      "name": "mannerpath-api-staging",
      "observability": { "enabled": true, "logs": { "enabled": true, "invocation_logs": false } },
      // App Attest required. Until REPORT_APP_ATTEST_APP_ID, REPORT_APP_ATTEST_ENVIRONMENT and
      // REPORT_APP_ATTEST_BUNDLE_VERSIONS are set for this environment (never here), it answers 503 attestationUnavailable and
      // /v1/config reports reports.available = false. A remote environment must never accept
      // unattested reports. Do not change this here.
      "vars": { "REPORT_ATTESTATION": "required" },
      "r2_buckets": [{ "binding": "RAW_ARTIFACTS", "bucket_name": "mannerpath-raw-artifacts-staging" }],
      "triggers": { "crons": [] },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "mannerpath-staging",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations"
        },
        {
          "binding": "REPORTS_DB",
          "database_name": "mannerpath-staging-reports",
          "database_id": "00000000-0000-0000-0000-000000000001",
          "migrations_dir": "migrations-reports"
        }
      ]
    },
    "production": {
      "name": "mannerpath-api-production",
      "observability": { "enabled": true, "logs": { "enabled": true, "invocation_logs": false } },
      // App Attest required, exactly as staging.
      "vars": { "REPORT_ATTESTATION": "required" },
      "r2_buckets": [{ "binding": "RAW_ARTIFACTS", "bucket_name": "mannerpath-raw-artifacts-production" }],
      "triggers": { "crons": [] },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "mannerpath-production",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations"
        },
        {
          "binding": "REPORTS_DB",
          "database_name": "mannerpath-production-reports",
          "database_id": "00000000-0000-0000-0000-000000000001",
          "migrations_dir": "migrations-reports"
        }
      ]
    }
  }
}
