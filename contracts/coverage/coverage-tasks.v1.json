{
  "contract": "mannerpath-coverage-tasks",
  "rules": "coverage-tasks.v1",
  "note": "Spot task kinds derived from a published spot's public fields (services/api/src/coverage/tasks.ts, apps/apple CoverageTasks.swift). Order of `expected` is the rule order.",
  "now": "2026-10-01T00:00:00Z",
  "cases": [
    { "name": "fresh official spot with known type and access needs nothing",
      "spot": { "spotType": "designatedOutdoorArea", "accessType": "public", "lastVerifiedAt": "2026-06-01",
                "verification": { "existence": "official", "locationPrecision": "publisherPoint", "confirmations": null, "lastReviewedMonth": "2026-06" } },
      "expected": [] },
    { "name": "stale official spot needs confirmation",
      "spot": { "spotType": "ashtray", "accessType": "public", "lastVerifiedAt": "2023-01-15",
                "verification": { "existence": "official", "locationPrecision": "publisherPoint", "confirmations": null, "lastReviewedMonth": "2023-01" } },
      "expected": ["needsConfirmation"] },
    { "name": "aging official spot is not a task",
      "spot": { "spotType": "ashtray", "accessType": "public", "lastVerifiedAt": "2025-03-01",
                "verification": { "existence": "official", "locationPrecision": "publisherPoint", "confirmations": null, "lastReviewedMonth": "2025-03" } },
      "expected": [] },
    { "name": "single community report needs confirmation and a location check",
      "spot": { "spotType": "ashtray", "accessType": "public", "lastVerifiedAt": null,
                "verification": { "existence": "communityReported", "locationPrecision": "communityPinned", "confirmations": 1, "lastReviewedMonth": "2026-09" } },
      "expected": ["needsConfirmation", "needsLocationCheck"] },
    { "name": "community-verified spot with two submitters needs nothing",
      "spot": { "spotType": "ashtray", "accessType": "customerOnly", "lastVerifiedAt": null,
                "verification": { "existence": "communityVerified", "locationPrecision": "communityPinned", "confirmations": 2, "lastReviewedMonth": "2026-09" } },
      "expected": [] },
    { "name": "unknown type and access are checks",
      "spot": { "spotType": "unknown", "accessType": "unknown", "lastVerifiedAt": "2026-08-01",
                "verification": { "existence": "official", "locationPrecision": "publisherPoint", "confirmations": null, "lastReviewedMonth": "2026-08" } },
      "expected": ["needsTypeCheck", "needsAccessCheck"] },
    { "name": "derived location needs a location check",
      "spot": { "spotType": "publicSmokingRoom", "accessType": "public", "lastVerifiedAt": "2026-08-01",
                "verification": { "existence": "official", "locationPrecision": "reviewedDerived", "confirmations": null, "lastReviewedMonth": "2026-08" } },
      "expected": ["needsLocationCheck"] },
    { "name": "a spot without the ADR-0012 object needs nothing it cannot prove",
      "spot": { "spotType": "ashtray", "accessType": "public", "lastVerifiedAt": "2026-08-01" },
      "expected": [] },
    { "name": "official spot pinned at an area anchor needs a location check (ADR-0017)",
      "spot": { "spotType": "designatedOutdoorArea", "accessType": "public", "lastVerifiedAt": "2026-06-01",
                "verification": { "existence": "official", "locationPrecision": "areaApproximate", "confirmations": null, "lastReviewedMonth": "2026-06" } },
      "expected": ["needsLocationCheck"] }
  ]
}
